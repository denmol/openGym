{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api": {
      "root": "api",
      "runtime": "node"
    },
    "frontend": {
      "root": "frontend",
      "framework": "vite",
      "buildCommand": "VITE_IMG_BASE=https://raw.githubusercontent.com/hasaneyldrm/exercises-dataset/main/images/ VITE_GIF_BASE=https://raw.githubusercontent.com/hasaneyldrm/exercises-dataset/main/videos/ npm run build"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
