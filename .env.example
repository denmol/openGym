# Copy to .env and fill in. Passkeys bind to the hostname, so RP_ID and ORIGIN
# must match the address bar exactly — changing them later invalidates every
# passkey that was already created.
RP_ID=gym.example.com
ORIGIN=https://gym.example.com
RP_NAME=openGym

# Port the web container publishes on, behind your own reverse proxy.
WEB_PORT=8080

# Where the server keeps its data: users, passkey credentials, the session-signing secret,
# the VAPID keypair, and one file per profile with their workouts, food log and glucose
# readings. Defaults to ./data inside the checkout. Point it somewhere outside the
# checkout if you would rather your account database were not sitting in a git working
# tree. Whatever you choose: this is the directory to back up, and it must never be
# committed — a leaked ./data/secret lets anyone forge a signed session cookie.
# DATA_DIR=/var/lib/opengym

# Optional. Your profile id gets the admin dashboard: sign in, then tap the account row at
# the top of Settings to copy it. INVITE_ONLY closes open registration.
# ADMIN_UIDS=
# INVITE_ONLY=1

# --- AI coach (optional) ---
# Leave OPENAI_API_KEY unset and the coach still works: the app builds a prompt you paste
# into any chat yourself. Set it and the app generates and self-corrects on its own.
# The key stays in the server; it is never sent to a browser.
# OPENAI_API_KEY=sk-...
# COACH_MODEL=gpt-5.6-luna        # gpt-5.6-terra and gpt-5.6-sol cost more, think harder
# COACH_REASONING=low             # none | minimal | low | medium | high | xhigh | max
# COACH_DAILY_LIMIT=20            # generations per user per day — the cap on a runaway loop
# OPENAI_BASE_URL=                # for an OpenAI-compatible endpoint

# --- Barcode lookup (Open Food Facts) ---
# On by default. Scanned barcodes are looked up through this server rather than from the
# browser, so the phones never talk to a third party about what is in the fridge, and the
# answers are cached under DATA_DIR/off so a second scan of the same packet needs no network.
# OFF_ENABLED=0                   # switch barcode lookup off entirely
# OFF_TTL_DAYS=30                 # how long a cached product stays fresh
# OFF_DAILY_LIMIT=300             # lookups per user per day, so this server is never the
#                                 # reason Open Food Facts rate-limits anyone
# OFF_USER_AGENT=                 # Open Food Facts asks callers to identify themselves
# OFF_BASE_URL=                   # for a mirror, or for testing against a stand-in
